              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.environment.set(\"jwt_token\", res.data.token);",
                  "    console.log(\"JWT Token atualizado automaticamente no ambiente!\");",
                  "}",
                  "if (res.data && res.data.refreshToken) {",
