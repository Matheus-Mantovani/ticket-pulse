{
  "imports": {
    "express": "npm:express@^4.19.2",
    "@types/express": "npm:@types/express@^4.17.21",
    "cors": "npm:cors@^2.8.5",
    "@types/cors": "npm:@types/cors@^2.8.17",
    "morgan": "npm:morgan@^1.10.0",
    "@types/morgan": "npm:@types/morgan@^1.9.9",
    "mongoose": "npm:mongoose@^8.3.0",
    "dotenv/config": "npm:dotenv@^16.4.5/config",
    "responser": "npm:responser@^2.5.6",
    "throwlhos": "npm:throwlhos@^1.1.0",
    "request-check": "npm:request-check@^1.6.2",
    "@zarco/isness": "jsr:@zarco/isness@^0.1.18",
    "jsonwebtoken": "npm:jsonwebtoken@^9.0.2",
    "@types/jsonwebtoken": "npm:@types/jsonwebtoken@^9.0.6",
    "bcryptjs": "npm:bcryptjs@^2.4.3",
    "@types/bcryptjs": "npm:@types/bcryptjs@^2.4.6",
    "swagger-ui-express": "npm:swagger-ui-express@^5.0.0",
    "@types/swagger-ui-express": "npm:@types/swagger-ui-express@^4.1.6",
    "swagger-jsdoc": "npm:swagger-jsdoc@^6.2.8",
    "@types/swagger-jsdoc": "npm:@types/swagger-jsdoc@^6.0.4",
    "supertest": "npm:supertest@^7.0.0",
    "@types/supertest": "npm:@types/supertest@^6.0.2",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-env --allow-sys --watch src/main.ts",
    "dev:test": "deno run --allow-net --allow-read --allow-env --allow-sys --watch src/main.ts --test-db",
    "start": "deno run --allow-net --allow-read --allow-env --allow-sys src/main.ts",
    "test": "deno test --allow-net --allow-read --allow-env --allow-sys",
    "test:cov": "deno test --allow-net --allow-read --allow-env --allow-sys --coverage=cov_profile"
  },
  "lint": {
    "rules": {
      "exclude": ["no-namespace"]
    }
  },
  "compilerOptions": {
    "strict": true
  }
}
